{
  "name": "autoschedule",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --exclude tests/performance/**",
    "test:performance": "vitest run tests/performance",
    "test:watch": "vitest --exclude tests/performance/**",
    "verify": "npm run typecheck && npm test && npm run test:performance && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@bubblyworld/highs-ts": "^1.3.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "comlink": "^4.4.2",
    "es-module-lexer": "^2.0.0",
    "graphology": "^0.26.0",
    "graphology-dag": "^0.4.1",
    "html2canvas": "^1.4.1",
    "immer": "^11.1.15",
    "lit": "^3.3.1",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/bootstrap": "^5.2.10",
    "@types/node": "^24.10.1",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "tinybench": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.15"
  }
}
